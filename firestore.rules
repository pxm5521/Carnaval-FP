rules_version = '2';

// Regras de segurança do Firestore para o site do Carnaval do Fogo e Paixão.
//
// ESTRUTURA
// Os dados permanentes de cada pessoa (nome, apelido, e-mail e os acessos de
// organização) ficam em /pessoas/{uid}. O contato — celular e data de nascimento
// — fica separado, em /contatos/{uid}, porque tem leitura restrita. Tudo o que
// muda de um carnaval para o outro vive dentro da edição correspondente, em
// /edicoes/{eid}/... — inscrições, posições, ensaios, músicas, valores,
// pagamentos e presenças.
//
// MODELO DE CONFIANÇA
// É um grupo pequeno e conhecido (a bateria). Qualquer pessoa logada pode VER o
// nome/posição/presença de todos, mas só pode MARCAR presença quem tem
// adminAccess ou presencaAccess. Os dados pessoais mais sensíveis são restritos
// ao próprio dono E À ORGANIZAÇÃO: o contato em /contatos e os pagamentos
// individuais em /edicoes/{eid}/pagamentos. Um batuqueiro comum não vê nem o
// contato nem o pagamento de ninguém além de si mesmo. Ações administrativas
// exigem adminAccess = true.
//
// EDIÇÃO ENCERRADA É IMUTÁVEL
// Uma edição com status "encerrada" não aceita mais nenhuma escrita nas suas
// subcoleções — nem do admin. Para corrigir algo depois do carnaval, o admin
// reabre a edição (volta para "preparando") e só então consegue editar.

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // true se o usuário logado tem acesso ao painel admin.
    // A segunda metade cobre o período de transição: enquanto a migração do
    // formato antigo não foi feita, o cadastro do admin ainda está em /users.
    // Depois de migrar, essa parte pode ser removida.
    function isAdmin() {
      return isSignedIn() && (
        (exists(/databases/$(database)/documents/pessoas/$(request.auth.uid))
          && get(/databases/$(database)/documents/pessoas/$(request.auth.uid)).data.adminAccess == true)
        || (exists(/databases/$(database)/documents/users/$(request.auth.uid))
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.adminAccess == true)
      );
    }

    // true se o usuário logado pode marcar presença nos ensaios: todo admin pode,
    // e além deles quem recebeu individualmente presencaAccess = true.
    // Igual ao isAdmin(): durante a transição o acesso pode estar só no cadastro
    // antigo. Sem essa segunda origem, quem recebeu o acesso antes da importação
    // via os botões SIM/NÃO na tela mas levava erro de permissão ao clicar.
    // Escrito sem chamar isAdmin() aqui dentro de propósito: cada regra tem um
    // teto de acessos a outros documentos por requisição, e a versão anterior
    // consultava os mesmos dois cadastros duas vezes (uma dentro de isAdmin(),
    // outra fora) e ainda somava o get() do status da edição — perto demais do
    // limite para uma ação que a bateria inteira usa em todo ensaio. Esta
    // versão toca cada cadastro uma vez só, mantendo exatamente a mesma
    // permissão: admin ou quem recebeu presencaAccess, no formato novo ou no
    // antigo.
    function podeEditarPresenca() {
      return isSignedIn() && (
        (exists(/databases/$(database)/documents/pessoas/$(request.auth.uid))
          && (get(/databases/$(database)/documents/pessoas/$(request.auth.uid)).data.adminAccess == true
              || get(/databases/$(database)/documents/pessoas/$(request.auth.uid)).data.presencaAccess == true))
        || (exists(/databases/$(database)/documents/users/$(request.auth.uid))
          && (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.adminAccess == true
              || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.presencaAccess == true))
      );
    }

    function statusDaEdicao(eid) {
      return get(/databases/$(database)/documents/edicoes/$(eid)).data.status;
    }
    function edicaoNaoEncerrada(eid) {
      return statusDaEdicao(eid) != 'encerrada';
    }
    function edicaoAberta(eid) {
      return statusDaEdicao(eid) == 'aberta';
    }

    // ---------- cadastro permanente de cada pessoa ----------
    match /pessoas/{uid} {
      allow read: if isSignedIn();

      // no cadastro inicial, a pessoa só pode criar o PRÓPRIO documento e não
      // pode nascer com privilégios (evita que alguém se autopromova a admin ou
      // se autoconceda o acesso de marcar presença).
      // O admin também pode criar cadastros de terceiros — é o que a importação
      // do formato antigo faz ao trazer as pessoas que já existiam.
      // O e-mail tem que ser o do login: é por ele que a organização identifica
      // e cobra a pessoa, e ele vai para a planilha exportada. A exceção cobre
      // quem vem do formato antigo, cujo cadastro traz o e-mail de lá.
      allow create: if isAdmin()
        || (isOwner(uid)
            && request.resource.data.adminAccess == false
            && request.resource.data.presencaAccess == false
            && (request.resource.data.email == request.auth.token.email
                || exists(/databases/$(database)/documents/users/$(request.auth.uid))));

      // o dono edita os próprios dados, mas não pode mudar os acessos —
      // só um admin pode — nem forjar o e-mail que a organização vê e exporta.
      // O nascimento aqui é resto do formato antigo (hoje vive em /contatos) e
      // segue o mesmo formato exigido lá, pelo mesmo motivo.
      allow update: if isAdmin()
        || (isOwner(uid)
            && request.resource.data.adminAccess == resource.data.adminAccess
            && request.resource.data.presencaAccess == resource.data.presencaAccess
            && request.resource.data.email == resource.data.email
            && (!('dataNascimento' in request.resource.data)
                || (request.resource.data.dataNascimento is string
                    && request.resource.data.dataNascimento.matches('^$|^[0-9]{4}-[0-9]{2}-[0-9]{2}$'))));

      allow delete: if isAdmin();
    }

    // ---------- contato (celular e data de nascimento) ----------
    // Fica separado de /pessoas de propósito. /pessoas precisa ser legível por
    // qualquer pessoa logada (é o que monta a lista da bateria, a presença e o
    // histórico), e regra do Firestore não filtra CAMPO, só DOCUMENTO — então,
    // enquanto o celular morasse lá dentro, qualquer pessoa com cadastro no site
    // poderia ler o telefone e o nascimento de todo mundo consultando o banco
    // direto, mesmo que a tela não mostrasse.
    //
    // Aqui a leitura é individual: cada pessoa lê o próprio contato, e a
    // organização lê o de todos (precisa, para falar com a bateria). Repare que
    // o app só consegue LISTAR /contatos sendo admin — uma consulta de coleção
    // inteira feita por um batuqueiro comum é recusada, porque a regra teria que
    // valer para todos os documentos retornados.
    // A validação do formato da data não é capricho: a data de nascimento é
    // devolvida para dentro de um campo do formulário do painel, e um valor com
    // aspas e um atributo de evento executaria código na sessão de quem abrisse
    // aquele cadastro — o admin. O site também escapa na hora de desenhar; esta
    // é a barreira do lado do servidor.
    function contatoBemFormado() {
      return request.resource.data.keys().hasOnly(['celular', 'dataNascimento'])
        && (!('dataNascimento' in request.resource.data)
            || request.resource.data.dataNascimento is string)
        && (!('dataNascimento' in request.resource.data)
            || request.resource.data.dataNascimento.matches('^$|^[0-9]{4}-[0-9]{2}-[0-9]{2}$'))
        && (!('celular' in request.resource.data)
            || (request.resource.data.celular is string && request.resource.data.celular.size() < 40));
    }

    match /contatos/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create, update: if (isOwner(uid) || isAdmin()) && contatoBemFormado();
      allow delete: if isAdmin();
    }

    // ---------- edições do carnaval ----------
    match /edicoes/{eid} {
      allow read: if isSignedIn();
      allow write: if isAdmin();

      // ---------- inscrição de cada pessoa naquele carnaval ----------
      // A LISTA DE CAMPOS ABAIXO É UMA BARREIRA DE SEGURANÇA, não organização.
      // As telas montam cada batuqueiro fundindo /pessoas com a inscrição, e a
      // inscrição fica por cima. Sem a lista, o dono podia gravar
      // adminAccess: true (ou um nome/e-mail falso) na PRÓPRIA inscrição; o
      // painel desenhava o selo de admin e a caixa "Acesso ao painel admin" já
      // marcada, e o admin, ao salvar qualquer outra coisa daquela pessoa,
      // gravava a promoção de verdade em /pessoas. Campo novo na inscrição
      // precisa ser acrescentado aqui, senão o site quebra — e é de propósito.
      match /inscricoes/{uid} {
        allow read: if isSignedIn();

        function camposPermitidosDoDono() {
          return request.resource.data.keys().hasOnly([
            'vaiTocar', 'posicao', 'posicaoOutro', 'camisa',
            'isentoManual', 'formaPagamento', 'totalPago', 'inscritoEm'
          ]);
        }

        // a pessoa se inscreve sozinha só numa edição ABERTA, e não pode nascer
        // isenta nem com pagamento já lançado.
        allow create: if (isAdmin() && edicaoNaoEncerrada(eid))
          || (isOwner(uid) && edicaoAberta(eid)
              && camposPermitidosDoDono()
              && request.resource.data.isentoManual == false
              && request.resource.data.totalPago == 0);

        // o dono atualiza os próprios dados da inscrição (inclusive totalPago,
        // ao registrar um pagamento), mas a isenção só o admin concede.
        //
        // O total pago é gravado pelo cliente porque não existe servidor próprio
        // aqui — é a limitação conhecida, documentada no SETUP. Ele precisa poder
        // cair, porque o dono pode remover um lançamento que fez errado; exigir
        // que só crescesse prendia a pessoa ao próprio erro sem proteger nada
        // (declarar que pagou MENOS nunca é vantagem para quem declara).
        allow update: if (isAdmin() && edicaoNaoEncerrada(eid))
          || (isOwner(uid) && edicaoAberta(eid)
              && camposPermitidosDoDono()
              && request.resource.data.isentoManual == resource.data.isentoManual
              && request.resource.data.totalPago is number
              && request.resource.data.totalPago >= 0);

        allow delete: if isAdmin() && edicaoNaoEncerrada(eid);
      }

      // ---------- posições, ensaios, músicas e valores daquele carnaval ----------
      match /posicoes/{id} {
        allow read: if isSignedIn();
        allow write: if isAdmin() && edicaoNaoEncerrada(eid);
      }
      match /ensaios/{id} {
        allow read: if isSignedIn();
        allow write: if isAdmin() && edicaoNaoEncerrada(eid);
      }
      match /musicas/{id} {
        allow read: if isSignedIn();
        allow write: if isAdmin() && edicaoNaoEncerrada(eid);
      }
      match /config/{id} {
        allow read: if isSignedIn();
        allow write: if isAdmin() && edicaoNaoEncerrada(eid);
      }

      // ---------- pagamentos individuais (pix/data/valor) ----------
      // só o próprio dono lê os detalhes; o admin usa o total já somado na
      // inscrição para o relatório, então não precisa ler aqui.
      match /pagamentos/{id} {
        // A organização lê os comprovantes de todo mundo. Não era assim antes, e
        // a mudança é deliberada: o comprovante guarda o NOME de quem fez o Pix,
        // que existe justamente para o organizador achar o lançamento no extrato
        // do bloco. Sem leitura, o campo não servia para nada, ninguém conseguia
        // conferir uma divergência entre o total e os comprovantes, e um erro de
        // digitação só podia ser desfeito pela própria pessoa. O rodapé do site
        // informa os batuqueiros disso.
        allow read: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
        allow create: if ((isSignedIn() && request.resource.data.uid == request.auth.uid && edicaoAberta(eid))
                          || (isAdmin() && edicaoNaoEncerrada(eid)))
          && request.resource.data.valor is number
          && request.resource.data.valor > 0;
        // O DONO não edita, só remove e lança de novo — assim um valor nunca
        // muda por baixo no registro dele. Remover não abre brecha: um
        // pagamento é uma declaração a FAVOR de quem o registrou, então apagá-lo
        // só trabalha contra ele.
        // A ORGANIZAÇÃO pode corrigir e remover, porque é quem confere contra o
        // extrato do bloco e responde pela conta. A correção não pode trocar o
        // dono do lançamento nem zerar o valor.
        allow update: if isAdmin()
          && edicaoNaoEncerrada(eid)
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.valor is number
          && request.resource.data.valor > 0;
        allow delete: if (isAdmin() && edicaoNaoEncerrada(eid))
          || (isSignedIn()
              && resource.data.uid == request.auth.uid
              && edicaoAberta(eid));
      }

      // ---------- presença nos ensaios ----------
      // qualquer pessoa logada VÊ a presença de todos; só quem tem
      // podeEditarPresenca() marca/desmarca, e apenas em edição não encerrada.
      // O admin tem um caminho próprio, sem a exigência de updatedBy == ele
      // mesmo, porque a importação do formato antigo traz registros históricos
      // marcados por outras pessoas.
      match /presencas/{id} {
        allow read: if isSignedIn();
        allow create, update: if (isAdmin() && edicaoNaoEncerrada(eid))
          || (podeEditarPresenca()
              && edicaoNaoEncerrada(eid)
              && request.resource.data.updatedBy == request.auth.uid
              && request.resource.data.presente is bool);
        allow delete: if false;
      }
    }

    // ============================================================
    // FORMATO ANTIGO (antes da separação por edições)
    // Mantido só para leitura, para que a importação única consiga ler os dados
    // que já existiam. Depois de importar e conferir tudo, estes blocos podem ser
    // apagados — e, junto com eles, as coleções antigas no Firebase Console.
    // ============================================================
    // ATENÇÃO: estes documentos guardam celular e data de nascimento — foi de
    // dentro deles que a separação para /contatos tirou esses campos. Deixar a
    // leitura aberta aqui anularia a separação inteira enquanto a coleção
    // antiga existisse: bastaria consultar /users para ler o telefone de todo
    // mundo. Por isso a leitura é a mesma de /contatos — o dono e o admin. O
    // app só precisa disso: cada um lê o próprio cadastro antigo, e a listagem
    // completa só acontece na importação, feita por um admin.
    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if false;
    }
    match /posicoes/{id}   { allow read: if isSignedIn(); allow write: if false; }
    match /ensaios/{id}    { allow read: if isSignedIn(); allow write: if false; }
    match /musicas/{id}    { allow read: if isSignedIn(); allow write: if false; }
    match /config/{id}     { allow read: if isSignedIn(); allow write: if false; }
    match /presencas/{id}  { allow read: if isSignedIn(); allow write: if false; }
    match /pagamentos/{id} {
      allow read: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow write: if false;
    }
  }
}
